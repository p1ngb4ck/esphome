# component_as_lib post-build step (PlatformIO extra_script, stage "post").
#
# Runs after the firmware is built. For each captured target it:
#   1. compiles the component's own sources (from build/src/esphome/components/<comp>/) + the
#      generated glue with -fPIC, using the exact per-file flags from compile_commands.json,
#   2. links them -shared -> <target>.so,
#   3. reads the .so's undefined symbols (nm -u) -> generates a TARGETED host-symbol table
#      (esp_all_symbol.c) via elf_loader's tool/symbols.py,
#   4. relinks the firmware so the table (and the &symbol refs that also retain those symbols from
#      --gc-sections) is baked in.
#
# FIRST ITERATION: this cannot be validated without a real build, so it logs everything it discovers
# (build dir, compile_commands.json, firmware ELF, per-target sources) before acting. The parts that
# depend on the exact PlatformIO/IDF build-tree layout are marked ITERATE and kept conservative:
# nothing here mutates the firmware until the discovery output confirms the paths on a real run.

import json
import logging
import shlex
import subprocess
from pathlib import Path

Import("env")  # noqa: F821  (provided by PlatformIO)

_LOGGER = logging.getLogger("component_as_lib.post")
logging.basicConfig(level=logging.INFO)

PROJECT_DIR = Path(env.subst("$PROJECT_DIR"))  # noqa: F821
BUILD_DIR = Path(env.subst("$BUILD_DIR"))  # noqa: F821
SRC_DIR = PROJECT_DIR / "src"
GLUE_DIR = SRC_DIR / "esphome" / "component_libs"
MANIFEST = GLUE_DIR / "manifest.json"


def _find(paths, pattern, what):
    hits = []
    for base in paths:
        if base.is_dir():
            hits += list(base.rglob(pattern))
    _LOGGER.info("component_as_lib: %s -> %d candidate(s): %s", what, len(hits),
                 [str(h) for h in hits[:4]])
    return hits


def _compile_commands():
    # IDF/CMake writes compile_commands.json in the build tree. Location varies by toolchain layout.
    cands = _find([BUILD_DIR, PROJECT_DIR], "compile_commands.json", "compile_commands.json")
    for c in cands:
        try:
            return json.loads(c.read_text())
        except Exception as e:  # noqa: BLE001
            _LOGGER.warning("component_as_lib: cannot parse %s: %s", c, e)
    return None


def _firmware_elf():
    cands = _find([BUILD_DIR], "*.elf", "firmware ELF")
    # prefer the main app elf (largest is a decent heuristic; ITERATE: confirm exact name)
    return max(cands, key=lambda p: p.stat().st_size) if cands else None


def _command_for(cc, source_path):
    """Find the compile command for a given source file from compile_commands.json."""
    src = str(source_path)
    for entry in cc or []:
        f = entry.get("file", "")
        if f.endswith(source_path.name) and (src in f or source_path.name in f):
            return entry
    return None


def _build_so(target, glue_file, comp_dir, cc, out_so):
    """Compile the component's sources + glue as -fPIC and link -shared. ITERATE on exact flags."""
    sources = list(comp_dir.rglob("*.cpp")) + [Path(glue_file)]
    objs = []
    obj_dir = out_so.parent / f"{out_so.stem}.obj"
    obj_dir.mkdir(parents=True, exist_ok=True)
    for s in sources:
        entry = _command_for(cc, s)
        if entry is None:
            # the glue file has no compile_commands entry; borrow another entry's flags for it
            entry = _command_for(cc, next((x for x in sources if _command_for(cc, x)), s))
        if entry is None:
            _LOGGER.error("component_as_lib: no compile command for %s (and no donor) -- skipping so",
                          s)
            return None
        args = shlex.split(entry["command"])
        # drop the output + input file args, add -fPIC + -c, retarget output
        obj = obj_dir / (s.stem + ".o")
        # ITERATE: robustly strip -o <x> and the trailing source; conservative approach below
        filtered = []
        skip = False
        for a in args:
            if skip:
                skip = False
                continue
            if a == "-o":
                skip = True
                continue
            if a.endswith((".o", ".obj", ".cpp", ".cc", ".c")):
                continue
            filtered.append(a)
        cmd = filtered + ["-fPIC", "-c", str(s), "-o", str(obj)]
        _LOGGER.info("component_as_lib: CC %s", " ".join(cmd[:4]) + " ... " + str(s.name))
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            _LOGGER.error("component_as_lib: compile failed for %s:\n%s", s, r.stderr[-800:])
            return None
        objs.append(str(obj))
    # link -shared using the same compiler driver (first token of a compile command)
    cxx = shlex.split((cc[0]["command"]))[0] if cc else "riscv32-esp-elf-g++"
    link = [cxx, "-shared", "-fPIC", "-nostdlib", "-Wl,--gc-sections",
            "-fvisibility=hidden", "-o", str(out_so)] + objs
    _LOGGER.info("component_as_lib: LINK %s", out_so)
    r = subprocess.run(link, capture_output=True, text=True)
    if r.returncode != 0:
        _LOGGER.error("component_as_lib: link failed for %s:\n%s", out_so, r.stderr[-800:])
        return None
    return out_so


def _undefined_symbols(so_path):
    r = subprocess.run(["nm", "-u", "-C", "--no-demangle", str(so_path)] if False
                       else ["nm", "-u", str(so_path)], capture_output=True, text=True)
    syms = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] in ("U", "w"):
            syms.append(parts[1])
    _LOGGER.info("component_as_lib: %s has %d undefined symbols", so_path.name, len(syms))
    return syms


def main():
    _LOGGER.info("component_as_lib: post-build discovery")
    _LOGGER.info("  PROJECT_DIR=%s", PROJECT_DIR)
    _LOGGER.info("  BUILD_DIR=%s", BUILD_DIR)
    if not MANIFEST.is_file():
        _LOGGER.info("component_as_lib: no manifest (%s) -- nothing to do", MANIFEST)
        return
    manifest = json.loads(MANIFEST.read_text())
    cc = _compile_commands()
    elf = _firmware_elf()
    _LOGGER.info("component_as_lib: firmware ELF = %s", elf)
    if cc is None or elf is None:
        _LOGGER.error("component_as_lib: missing compile_commands.json or ELF -- see discovery above; "
                      "not modifying the build this run")
        return

    all_undefined = set()
    for item in manifest:
        target = item["target"]
        glue = item["glue"]
        # target is the component/platform NAME -> its source dir components/<target>/. The base
        # domain dir (e.g. sensor/) stays in the firmware and is resolved via the symbol table, so it
        # is NOT compiled into the .so. ITERATE: confirm no other dirs are needed on the first run.
        comp_guess = SRC_DIR / "esphome" / "components" / target
        _LOGGER.info("component_as_lib: target '%s' comp_dir guess = %s (exists=%s)",
                     target, comp_guess, comp_guess.is_dir())
        out_so = GLUE_DIR / f"{target.replace(':', '_').replace('.', '_')}.so"
        built = _build_so(target, glue, comp_guess, cc, out_so) if comp_guess.is_dir() else None
        if built:
            all_undefined |= set(_undefined_symbols(built))

    # ITERATE: generate the targeted esp_all_symbol.c from all_undefined via elf_loader tool/symbols.py
    # and relink. Deferred to the next iteration once .so building is confirmed on device -- this run
    # is discovery + .so build only, deliberately not yet touching the firmware link.
    _LOGGER.info("component_as_lib: %d total undefined symbols to export (targeted table next step)",
                 len(all_undefined))


main()
